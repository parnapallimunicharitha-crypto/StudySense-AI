import sqlite3

conn = sqlite3.connect("study.db", check_same_thread=False)
cur = conn.cursor()

cur.execute("""
CREATE TABLE IF NOT EXISTS study(
    date TEXT,
    subject TEXT,
    hours REAL
)
""")

conn.commit()


def add_data(date, subject, hours):
    cur.execute("INSERT INTO study VALUES(?,?,?)", (date, subject, hours))
    conn.commit()


def get_data():
    cur.execute("SELECT * FROM study")
    return cur.fetchall()
